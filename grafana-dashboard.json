        {
          "datasource": {
            "type": "influxdb"
          },
          "query": "errors = from(bucket: \"api-metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"api_request\")\n  |> filter(fn: (r) => r._field == \"count\")\n  |> filter(fn: (r) => r.status_class == \"4xx\" or r.status_class == \"5xx\")\n  |> aggregateWindow(every: 1m, fn: sum, createEmpty: false)\n  |> sum()\n\ntotal = from(bucket: \"api-metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"api_request\")\n  |> filter(fn: (r) => r._field == \"count\")\n  |> aggregateWindow(every: 1m, fn: sum, createEmpty: false)\n  |> sum()\n\njoin(\n  tables: {errors: errors, total: total},\n  on: [\"_time\", \"_field\"]\n)\n  |> map(fn: (r) => ({\n      _time: r._time,\n      _value: if r._value_total > 0 then (r._value_errors / r._value_total) * 100.0 else 0.0\n    }))",
          "refId": "A"
        }
      ],
      "title": "Error Rate",
      "type": "stat"
    },
